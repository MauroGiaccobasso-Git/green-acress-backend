generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================================================
 * USUARIOS Y AUTENTICACIÓN
 * =========================================================
 */

model Usuario {
  id                       Int                     @id @default(autoincrement())
  email                    String                  @unique
  password_hash            String
  intentos_fallidos        Int                     @default(0)
  bloqueado_hasta          DateTime?
  ventana_intentos_desde   DateTime?
  ultimo_intento_fallido   DateTime?
  proximo_intento_desde    DateTime?
  version_sesion           Int                     @default(0)
  requiere_cambio_password Boolean                 @default(false)
  password_temporal_expira DateTime?
  mfa_habilitado           Boolean                 @default(false)
  mfa_secreto_cifrado      String?
  fecha_configuracion_mfa  DateTime?
  fecha_creacion           DateTime                @default(now())
  fecha_actualizacion      DateTime                @updatedAt
  rol                      RolUsuario
  estado                   EstadoUsuario           @default(ACTIVO)
  compras                  Compra[]
  auditorias               Auditoria[]
  reservas                 Reserva[]
  historial_reservas       HistorialReserva[]
  socio                    Socio?
  ventas                   Venta[]
  desafios_autenticacion   DesafioAutenticacion[]
  recuperaciones_password  RecuperacionPassword[]
  codigos_recuperacion_mfa CodigoRecuperacionMfa[]

  @@index([estado])
  @@index([rol])
  @@index([proximo_intento_desde])
}

model DesafioAutenticacion {
  id             String                   @id @default(cuid())
  usuario_id     Int
  tipo           TipoDesafioAutenticacion
  token_hash     String                   @unique
  intentos       Int                      @default(0)
  expira_en      DateTime
  consumido_en   DateTime?
  fecha_creacion DateTime                 @default(now())
  usuario        Usuario                  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id, tipo])
  @@index([expira_en])
}

model RecuperacionPassword {
  id             String    @id @default(cuid())
  usuario_id     Int
  token_hash     String    @unique
  expira_en      DateTime
  consumido_en   DateTime?
  fecha_creacion DateTime  @default(now())
  usuario        Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([expira_en])
}

model CodigoRecuperacionMfa {
  id             Int       @id @default(autoincrement())
  usuario_id     Int
  codigo_hash    String
  usado_en       DateTime?
  fecha_creacion DateTime  @default(now())
  usuario        Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, codigo_hash])
  @@index([usuario_id, usado_en])
}

/**
 * =========================================================
 * SOCIOS
 * =========================================================
 */

model Socio {
  id                      Int            @id @default(autoincrement())
  usuario_id              Int            @unique
  documento               String         @unique
  nombre                  String
  apellido                String
  telefono                String
  fecha_alta              DateTime       @default(now())
  consentimiento_aceptado Boolean        @default(false)
  fecha_consentimiento    DateTime?
  fecha_creacion          DateTime       @default(now())
  fecha_actualizacion     DateTime       @updatedAt
  estado                  EstadoSocio    @default(ACTIVO)
  notificaciones          Notificacion[]
  reservas                Reserva[]
  usuario                 Usuario        @relation(fields: [usuario_id], references: [id])
  ventas                  Venta[]

  @@index([estado])
  @@index([nombre, apellido])
}

/**
 * =========================================================
 * PRODUCTOS Y STOCK
 * =========================================================
 */

model Producto {
  id                  Int               @id @default(autoincrement())
  nombre              String            @unique
  descripcion         String?
  precio_venta_actual Float?
  estado              EstadoProducto    @default(ACTIVO)
  fecha_creacion      DateTime          @default(now())
  fecha_actualizacion DateTime          @updatedAt
  genetica            GeneticaProducto?
  porcentaje_thc      Float?
  tipo                TipoProducto
  unidad_medida       UnidadMedida
  imagen_url          String?
  compras_detalle     CompraDetalle[]
  movimientos_stock   MovimientoStock[]
  reservas_detalle    ReservaDetalle[]
  stock               Stock?
  ventas_detalle      VentaDetalle[]
}

model Stock {
  id                  Int      @id @default(autoincrement())
  producto_id         Int      @unique
  cantidad_total      Float    @default(0)
  cantidad_reservada  Float    @default(0)
  cantidad_disponible Float    @default(0)
  fecha_actualizacion DateTime @updatedAt
  producto            Producto @relation(fields: [producto_id], references: [id])
}

model MovimientoStock {
  id              Int                 @id @default(autoincrement())
  producto_id     Int
  tipo            TipoMovimientoStock
  cantidad        Float
  referencia_id   Int?
  fecha_creacion  DateTime            @default(now())
  referencia_tipo String?
  observaciones   String?
  producto        Producto            @relation(fields: [producto_id], references: [id])

  @@index([producto_id, fecha_creacion])
  @@index([referencia_tipo, referencia_id])
}

/**
 * =========================================================
 * PROVEEDORES Y COMPRAS
 * =========================================================
 */

model Proveedor {
  id                  Int             @id @default(autoincrement())
  nombre              String
  contacto            String?
  telefono            String?
  email               String?
  estado              EstadoProveedor @default(ACTIVO)
  fecha_creacion      DateTime        @default(now())
  fecha_actualizacion DateTime        @updatedAt
  compras             Compra[]
}

model Compra {
  id                  Int             @id @default(autoincrement())
  proveedor_id        Int
  usuario_id          Int
  fecha               DateTime        @default(now())
  estado              EstadoCompra    @default(REGISTRADA)
  observaciones       String?
  fecha_creacion      DateTime        @default(now())
  fecha_actualizacion DateTime        @updatedAt
  proveedor           Proveedor       @relation(fields: [proveedor_id], references: [id])
  detalles            CompraDetalle[]
  usuario             Usuario         @relation(fields: [usuario_id], references: [id])
}

model CompraDetalle {
  id              Int      @id @default(autoincrement())
  compra_id       Int
  producto_id     Int
  cantidad        Float
  precio_unitario Float
  subtotal        Float
  compra          Compra   @relation(fields: [compra_id], references: [id])
  producto        Producto @relation(fields: [producto_id], references: [id])
}

/**
 * =========================================================
 * VENTAS
 * =========================================================
 */

model Venta {
  id                  Int            @id @default(autoincrement())
  socio_id            Int
  usuario_id          Int
  fecha               DateTime       @default(now())
  estado              EstadoVenta    @default(REGISTRADA)
  total               Float
  observaciones       String?
  fecha_creacion      DateTime       @default(now())
  fecha_actualizacion DateTime       @updatedAt
  socio               Socio          @relation(fields: [socio_id], references: [id])
  usuario             Usuario        @relation(fields: [usuario_id], references: [id])
  detalles            VentaDetalle[]
  reserva             Reserva?       @relation("ReservaVenta")
}

model VentaDetalle {
  id              Int      @id @default(autoincrement())
  venta_id        Int
  producto_id     Int
  cantidad        Float
  precio_unitario Float
  subtotal        Float
  producto        Producto @relation(fields: [producto_id], references: [id])
  venta           Venta    @relation(fields: [venta_id], references: [id])
}

/**
 * =========================================================
 * RESERVAS
 * =========================================================
 */

model Reserva {
  id                  Int                @id @default(autoincrement())
  socio_id            Int
  usuario_id          Int
  fecha_solicitud     DateTime           @default(now())
  fecha_limite_retiro DateTime?
  estado              EstadoReserva      @default(PENDIENTE)
  total               Float
  venta_id            Int?               @unique
  observaciones       String?
  fecha_actualizacion DateTime           @updatedAt
  historial           HistorialReserva[]
  socio               Socio              @relation(fields: [socio_id], references: [id])
  usuario             Usuario            @relation(fields: [usuario_id], references: [id])
  venta               Venta?             @relation("ReservaVenta", fields: [venta_id], references: [id])
  detalles            ReservaDetalle[]

  @@index([socio_id, estado])
  @@index([estado, fecha_limite_retiro])
}

model ReservaDetalle {
  id              Int      @id @default(autoincrement())
  reserva_id      Int
  producto_id     Int
  cantidad        Float
  precio_unitario Float
  subtotal        Float
  producto        Producto @relation(fields: [producto_id], references: [id])
  reserva         Reserva  @relation(fields: [reserva_id], references: [id])
}

model HistorialReserva {
  id            Int           @id @default(autoincrement())
  reserva_id    Int
  usuario_id    Int?
  estado        EstadoReserva
  fecha         DateTime      @default(now())
  observaciones String?
  reserva       Reserva       @relation(fields: [reserva_id], references: [id])
  usuario       Usuario?      @relation(fields: [usuario_id], references: [id])

  @@index([reserva_id, fecha])
}

/**
 * =========================================================
 * AUDITORÍA Y NOTIFICACIONES
 * =========================================================
 */

model Auditoria {
  id             Int      @id @default(autoincrement())
  usuario_id     Int
  accion         String
  entidad        String
  entidad_id     Int?
  detalle        String?
  fecha_creacion DateTime @default(now())
  usuario        Usuario  @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id, fecha_creacion])
  @@index([entidad, entidad_id])
}

model Notificacion {
  id             Int                @id @default(autoincrement())
  socio_id       Int?
  tipo           String
  mensaje        String
  canal          String
  estado         EstadoNotificacion @default(PENDIENTE)
  origen_id      Int?
  fecha_envio    DateTime?
  fecha_creacion DateTime           @default(now())
  origen_tipo    String?
  socio          Socio?             @relation(fields: [socio_id], references: [id])
}

/**
 * =========================================================
 * ENUMS DE USUARIOS Y AUTENTICACIÓN
 * =========================================================
 */

enum RolUsuario {
  ADMIN
  SOCIO
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum EstadoSocio {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum TipoDesafioAutenticacion {
  CAMBIO_PASSWORD_TEMPORAL
  VERIFICACION_MFA
  CONFIGURACION_MFA
}

/**
 * =========================================================
 * ENUMS OPERACIONALES
 * =========================================================
 */

enum EstadoProducto {
  ACTIVO
  INACTIVO
}

enum TipoProducto {
  FLOR
  SEMILLA
}

enum UnidadMedida {
  GRAMOS
  UNIDADES
}

enum GeneticaProducto {
  INDICA
  SATIVA
  HIBRIDA
}

enum EstadoProveedor {
  ACTIVO
  INACTIVO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  CANCELADA
  VENCIDA
  FINALIZADA
}

enum EstadoVenta {
  REGISTRADA
  ANULADA
}

enum EstadoCompra {
  REGISTRADA
  ANULADA
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  ERROR
}

enum TipoMovimientoStock {
  INGRESO
  EGRESO
  RESERVA
  RESERVA_CANCELADA
  RESERVA_VENCIDA
  AJUSTE
}
