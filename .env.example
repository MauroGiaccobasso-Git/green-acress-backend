# ==========================================
# PRISMA ORM - BASE DE DATOS
# ==========================================

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ==========================================
# JWT
# ==========================================

JWT_SECRET=REPLACE_WITH_A_SECURE_SECRET
JWT_EXPIRES_IN=8h

# ==========================================
# SEGURIDAD / CIFRADO
# ==========================================

ENCRYPTION_KEY=REPLACE_WITH_A_SECURE_32_BYTE_KEY
# Usuario técnico utilizado por procesos automáticos
SYSTEM_USER_EMAIL=system@greenacres.local

# ==========================================
# EMAIL (SMTP)
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=REPLACE_WITH_EMAIL
SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD

EMAIL_FROM_NAME="Green Acres"
EMAIL_FROM_ADDRESS=REPLACE_WITH_EMAIL

# ==========================================
# FRONTEND
# ==========================================

FRONTEND_URL=http://localhost:3000

# ==========================================
# SERVIDOR
# ==========================================

PORT=8080
NODE_ENV=development

# ==========================================
# JOBS
# ==========================================

# Cantidad de días hábiles para retirar una reserva confirmada
RESERVA_DIAS_LIMITE_RETIRO=3

ENABLE_RESERVATION_EXPIRATION_JOB=true
# Todos los días a las 00:05

RESERVATION_EXPIRATION_CRON="5 0 * * *"
RESERVATION_EXPIRATION_TIME_ZONE=America/Montevideo

# ==========================================
# INTELIGENCIA ARTIFICIAL - GEMINI
# ==========================================

GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000